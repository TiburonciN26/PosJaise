    "d": "Pedidos Web · búsqueda de clienta + estado",
    "roles": [
      "admin"
    ],
    "fuente": "select p.id, p.tipo_entrega, p.direccion_entrega, p.celular_entrega, p.costo_delivery, p.subtotal, p.descuento_cupon, p.total, p.estado, p.creado_en, p.metodo_pago, p.comprobante_url, p.cupon_codigo, p.tipo_comprobante, p.ruc, p.razon_social, p.pago_verificado, row_to_json(c1.*)::jsonb clientes, row_to_json(z1.*)::jsonb zonas from public.pedidos_web p\n    inner join lateral (select c.nombre, c.telefono from public.clientes c where c.nombre ilike '%maria%' and c.id = p.cliente_id limit 1) c1 on true\n    left join lateral (select z.nombre from public.zonas_delivery z where z.id = p.zona_delivery_id limit 1) z1 on true\n    where p.estado = 'ENTREGADO' order by p.creado_en desc, p.id desc limit 40 offset 0",
