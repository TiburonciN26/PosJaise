+async function leerTopServicios() {
+  const { data: ranking, error } = await supabase.rpc('servicios_mas_pedidos', { dias: 30 }).limit(CANDIDATOS_DESTACADOS)
+  if (error) throw error
+  const ids = (ranking ?? []).map((fila) => fila.servicio_id)
