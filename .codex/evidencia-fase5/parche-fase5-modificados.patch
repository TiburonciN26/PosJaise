+    .eq('cliente_id', miId)
+    .gte('fecha_hora', new Date().toISOString())
+    .in('estado', ['PENDIENTE', 'CONFIRMADA'])
+    .order('fecha_hora')
+    .limit(1)
+  if (error) throw error
+  return data?.[0] ?? null
