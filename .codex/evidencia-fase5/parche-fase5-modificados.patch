+  if (errorServicios) throw errorServicios
+  const porId = new Map((data ?? []).map((servicio) => [servicio.id, servicio]))
+  return ids.map((id) => porId.get(id)).filter(Boolean).slice(0, DESTACADOS_INICIO)
