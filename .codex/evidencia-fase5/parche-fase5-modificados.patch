+async function leerPromocionActiva(usuarioId) {
+  const { data, error } = await supabase
+    .from('promociones')
+    .select('id, titulo, descripcion, tipo_descuento, valor, vigente_hasta')
+    .order('vigente_hasta', { ascending: true, nullsFirst: false })
