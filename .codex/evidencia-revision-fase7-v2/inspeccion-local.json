        "definer": true,
        "argumentos": 0,
        "definicion": "CREATE OR REPLACE FUNCTION public.rol_actual()\n RETURNS text\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\n  select rol\n  from public.usuarios\n  where id = auth.uid()\n    and activo = true;\n$function$\n"
      }
