+   es una interacción breve, no un bucle infinito. */
+.cupon-chispa.cupon-chispa-lista {
+  animation: none;
+  opacity: 0.85;
+  transform: scale(0.8) rotate(45deg);
+}
+.cupon-envoltura-apagada .cupon-chispa-lista {
+  display: none;
+}
+
+/* Interacción breve: una pasada del destello y un par de centelleos mientras
+   el puntero está sobre el cupón o hay foco dentro (teclado / toque). Solo
+   transform/opacity. Con movimiento reducido no se anima nada: la tarjeta y
+   sus chispas quedan estáticas. */
+@keyframes cupon-sheen-pasada {
+  from {
+    transform: translateX(0) rotate(18deg);
+  }
+  to {
+    /* 175% del ancho de la tarjeta (de -45% a 130%) ÷ 30% de ancho propio */
+    transform: translateX(583%) rotate(18deg);
+  }
